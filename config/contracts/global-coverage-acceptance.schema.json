{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "purpose",
    "accepted_by",
    "acceptance_ref",
    "authenticated_operator_origin_receipt",
    "accepted_at",
    "expires_at",
    "revision_digest",
    "confers_runtime_activation",
    "confers_assignment_or_lease",
    "repositories"
  ],
  "properties": {
    "schema": {
      "const": "codestra.global-coverage-acceptance.v1"
    },
    "state": {
      "const": "ACCEPTED"
    },
    "purpose": {
      "const": "EXPLICIT_CONTROLLER_COVERAGE"
    },
    "accepted_by": {
      "const": "Ralph L. Appolon"
    },
    "acceptance_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "authenticated_operator_origin_receipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "revision_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confers_runtime_activation": {
      "const": false
    },
    "confers_assignment_or_lease": {
      "const": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 49,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codestra:global-coverage-acceptance:v1",
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "app_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "app_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "installation_id",
        "contract_version",
        "permissions",
        "selected_repository_inventory_receipt",
        "custody_receipt",
        "capability_receipt"
      ],
      "properties": {
        "app_id": {
          "type": "integer",
          "minimum": 1
        },
        "installation_id": {
          "type": "integer",
          "minimum": 1
        },
        "contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "permissions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "selected_repository_inventory_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "custody_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "capability_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256",
        "installation_receipt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "installation_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_ref",
        "source_level",
        "target_id",
        "target_ref",
        "target_level"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_level": {
          "enum": [
            "atomic_task",
            "subsection",
            "section",
            "development",
            "testing",
            "staging",
            "production"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target_level": {
          "enum": [
            "subsection",
            "section",
            "development",
            "testing",
            "staging",
            "production",
            "main"
          ]
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "assignment_id",
        "epoch",
        "principal",
        "role_oid",
        "state",
        "expires_at",
        "online_receipt_ref"
      ],
      "properties": {
        "lease_id": {
          "type": "string",
          "format": "uuid"
        },
        "assignment_id": {
          "type": "string",
          "format": "uuid"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "role_oid": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "const": "ACTIVE"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "online_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "assignment_id",
        "principal",
        "role_oid",
        "operation",
        "source_ref",
        "target_ref",
        "head_sha",
        "base_sha",
        "pr_number",
        "delegation_or_receipt_ref",
        "lease"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "assignment_id": {
          "type": "string",
          "format": "uuid"
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "role_oid": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "SCOPED_WRITE_ADMISSION",
            "SCOPE_CERTIFICATION",
            "ATOMIC_INCLUSION"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "delegation_or_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "lease": {
          "$ref": "#/$defs/lease"
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "required_checks",
        "required_approvals",
        "require_codeowner",
        "dismiss_stale_reviews",
        "require_last_push_approval",
        "require_conversation_resolution",
        "strict_checks",
        "enforce_admins",
        "bypass_present",
        "effective_rules_digest",
        "enforcement_receipt"
      ],
      "properties": {
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "required_approvals": {
          "type": "integer",
          "minimum": 1
        },
        "require_codeowner": {
          "const": true
        },
        "dismiss_stale_reviews": {
          "const": true
        },
        "require_last_push_approval": {
          "const": true
        },
        "require_conversation_resolution": {
          "const": true
        },
        "strict_checks": {
          "const": true
        },
        "enforce_admins": {
          "const": true
        },
        "bypass_present": {
          "const": false
        },
        "effective_rules_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "enforcement_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "product",
        "publisher",
        "certifier",
        "certificate_name",
        "controller_contexts",
        "atomic_purpose_acceptance_ref",
        "installed_versions",
        "registration",
        "tasks",
        "target_protection"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^appolon1908/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "publisher": {
          "$ref": "#/$defs/producer"
        },
        "certifier": {
          "$ref": "#/$defs/producer"
        },
        "certificate_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "controller_contexts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "codestra-control-plane",
              "codestra/control-plane"
            ]
          }
        },
        "atomic_purpose_acceptance_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "installed_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_commit",
            "source_tree",
            "controller_manifest_sha256",
            "installed_custody_receipt",
            "interpreter",
            "dependencies",
            "system_tools",
            "schema_migrations"
          ],
          "properties": {
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "controller_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "installed_custody_receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "interpreter": {
              "$ref": "#/$defs/artifact"
            },
            "dependencies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "system_tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "schema_migrations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "inventory_digest",
            "graph_digest",
            "inventory_complete",
            "environment_refs",
            "canonical_edges",
            "atomic_inventory_receipts",
            "current_registry_receipt"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "inventory_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "graph_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "inventory_complete": {
              "const": true
            },
            "environment_refs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "development",
                "testing",
                "staging",
                "production",
                "release"
              ],
              "properties": {
                "development": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "testing": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "staging": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "production": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "release": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            },
            "canonical_edges": {
              "type": "array",
              "minItems": 0,
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/edge"
              }
            },
            "atomic_inventory_receipts": {
              "type": "array",
              "minItems": 0,
              "maxItems": 1000,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "current_registry_receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "target_protection": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/protection"
          }
        }
      }
    }
  },
  "$comment": "Structural specification only. A protected origin and current online cross-field/inventory/graph/identity verification are mandatory; JSON schema validation alone never authenticates acceptance. No runtime consumer is activated by this source contract."
}
