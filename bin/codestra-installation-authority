#!/usr/bin/python3 -I
"""Stdlib-only source custody guard precedes all producer/project imports."""
import sys
sys.dont_write_bytecode=True
import os
import stat
import json
import hashlib
from pathlib import Path


def validate_source(root,digest,*,owner=0):
    root=Path(root).absolute()
    def read(path,mode):
        fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY)
        current=Path('/')
        try:
            for part in path.parts[1:-1]:
                if part in ('.','..'):raise ValueError
                child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd);os.close(fd);fd=child
                current=current/part
                info=os.fstat(fd)
                if (owner==0 or current==root or root in current.parents) and (info.st_uid!=owner or info.st_mode&0o022):raise ValueError
            source=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd)
            with os.fdopen(source,'rb') as stream:
                before=os.fstat(stream.fileno())
                if not stat.S_ISREG(before.st_mode) or before.st_nlink!=1 or before.st_uid!=owner or stat.S_IMODE(before.st_mode)!=mode or before.st_size>16*1024*1024:raise ValueError
                raw=stream.read(16*1024*1024+1);after=os.fstat(stream.fileno())
                fields=('st_dev','st_ino','st_size','st_mode','st_uid','st_gid','st_nlink','st_mtime_ns','st_ctime_ns')
                if any(getattr(before,k)!=getattr(after,k) for k in fields) or len(raw)>16*1024*1024:raise ValueError
                return raw
        finally:os.close(fd)
    def unique(pairs):
        result={}
        for k,v in pairs:
            if k in result:raise ValueError
            result[k]=v
        return result
    manifest=read(root/'installation-authority-source-manifest.json',0o644)
    if type(digest) is not str or hashlib.sha256(manifest).hexdigest()!=digest:raise ValueError
    value=json.loads(manifest,object_pairs_hook=unique)
    if (value.get('schema')!='codestra.installation-authority-source.v1' or value.get('source_only') is not True
            or any(value.get(k) is not False for k in ('install_allowed','activation_allowed','authority_provisioning_approved'))
            or value.get('installation_profile') is not None
            or type(value.get('source_commit')) is not str or len(value['source_commit'])!=40
            or any(c not in '0123456789abcdef' for c in value['source_commit'])):raise ValueError
    required={'017-installation-authority.sql','lib/codestra_control/installation_authority.py',
        'lib/codestra_control/__init__.py','bin/codestra-installation-authority','requirements-publisher.txt',
        'vendor/psycopg2_binary-2.9.10-cp312-cp312-manylinux_2_17_x86_64.manylinux2014_x86_64.whl'}
    inventory=set()
    for record in value['files']:
        name=record['path']
        if name not in required or name in inventory:raise ValueError
        inventory.add(name);mode=0o755 if name.startswith('bin/') else 0o644
        if record['mode']!=oct(mode):raise ValueError
        raw=read(root/name,mode)
        if len(raw)!=record['size'] or hashlib.sha256(raw).hexdigest()!=record['sha256']:raise ValueError
    if inventory!=required:raise ValueError
    wheel=next(record for record in value['files'] if record['path'].endswith('.whl'))
    if value.get('driver')!={key:wheel[key] for key in ('path','sha256','size')}:raise ValueError
    def failed(error):raise error
    for directory,dirs,files in os.walk(root/'lib',followlinks=False,onerror=failed):
        for name in dirs:
            path=Path(directory)/name;info=path.lstat();relative=str(path.relative_to(root))+'/'
            if not stat.S_ISDIR(info.st_mode) or info.st_uid!=owner or info.st_mode&0o022 or not any(p.startswith(relative) for p in required):raise ValueError
        for name in files:
            if str((Path(directory)/name).relative_to(root)) not in required:raise ValueError
    return root


if __name__=='__main__':
    try:
        if os.getuid()==0 or os.geteuid()==0 or not sys.flags.isolated:raise ValueError
        if sys.argv.count('--manifest-sha256')!=1:raise ValueError
        digest=sys.argv[sys.argv.index('--manifest-sha256')+1]
        root=validate_source(Path(__file__).absolute().parent.parent,digest)
    except Exception:
        print('INSTALLATION_AUTHORITY_SOURCE_CUSTODY_UNAVAILABLE');raise SystemExit(1)
    sys.path.insert(0,str(root/'lib'))
    from codestra_control.installation_authority import main
    raise SystemExit(main())
