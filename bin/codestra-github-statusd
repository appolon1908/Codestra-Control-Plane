#!/usr/bin/env python3
import json, os, subprocess, psycopg2
from psycopg2.extras import RealDictCursor

OWNER="appolon1908"
CONTEXT="codestra-control-plane"
DSN=os.environ.get("CODESTRA_CONTROL_DSN","host=127.0.0.1 port=5432 dbname=codestra_dev_control user=codestra")
GOVERNED_REPOS={"Middleware-","Kong","Caddy","Keycloak","Codestra-OpenBao","N8N"}
BOOTSTRAP_HEADS={"governance/development-control-plane-v1","workstation/governance-control-plane"}
ROOT_BASES={"main","development","release/production-activation"}

def run(args,check=True):
    p=subprocess.run(args,text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if check and p.returncode:
        raise RuntimeError(p.stderr.strip() or p.stdout.strip())
    return p

def gh_json(path):
    return json.loads(run(["gh","api",path]).stdout)

def remote_sha(repo_path,ref):
    p=run(["git","-c",f"safe.directory={repo_path}","-C",repo_path,
           "ls-remote","origin",f"refs/heads/{ref}"],check=False)
    return p.stdout.split()[0] if p.returncode==0 and p.stdout.strip() else ""

def post(repo,sha,state,desc,url):
    run([
      "gh","api","--method","POST",f"repos/{OWNER}/{repo}/statuses/{sha}",
      "-f",f"state={state}",
      "-f",f"context={CONTEXT}",
      "-f",f"description={desc[:140]}",
      "-f",f"target_url={url}"
    ])

def aliases(c):
    with c.cursor(cursor_factory=RealDictCursor) as cur:
        cur.execute("SELECT product,repository,test_branch FROM products ORDER BY repository")
        rows=cur.fetchall()
    out=[]
    for row in rows:
        repo_full=row["repository"]
        if not repo_full.startswith(OWNER+"/"):
            continue
        repo=repo_full.split("/",1)[1]
        if repo not in GOVERNED_REPOS:
            continue
        out.append((repo,row["product"],row["test_branch"],f"/srv/codestra/apps/{repo}"))
    return out

def section_target(c,product,base):
    with c.cursor() as cur:
        cur.execute("SELECT 1 FROM sections WHERE product=%s AND branch=%s",(product,base))
        return bool(cur.fetchone())

def governed(c,product,test_branch,base):
    if base in {"main","development",test_branch,"staging","production"}:
        return True
    return section_target(c,product,base)

def validate(c,product,test_branch,repo_path,head,base,sha):
    observed=remote_sha(repo_path,head)
    if observed!=sha:
        return False,"remote head SHA mismatch"

    if head in BOOTSTRAP_HEADS and base in ROOT_BASES:
        return True,"bootstrap governance installation"
    if (head.startswith("workstation/standalone-v3-") or head.startswith("governance/standalone-v3-")) and base=="development":
        return True,"standalone v3 governance bootstrap"

    with c.cursor(cursor_factory=RealDictCursor) as cur:
        if head.startswith("subsection/"):
            cur.execute(
              "SELECT status,remote_sha,parent_branch FROM workstations WHERE product=%s AND branch=%s",
              (product,head)
            )
            row=cur.fetchone()
            if not row or row["parent_branch"]!=base:
                return False,"subsection parent mismatch"
            return bool(row["status"]=="CERTIFIED" and row["remote_sha"]==sha),"subsection exact-SHA certification"

        if base=="development":
            cur.execute("SELECT section_key FROM sections WHERE product=%s AND branch=%s",(product,head))
            sec=cur.fetchone()
            if not sec:
                return False,f"invalid section {head}"
            cur.execute("""SELECT status,sha FROM scope_certifications
              WHERE product=%s AND scope_type='SECTION' AND scope_name=%s""",
              (product,sec["section_key"]))
            row=cur.fetchone()
            return bool(row and row["status"]=="CERTIFIED" and row["sha"]==sha),f"section {sec['section_key']} exact-SHA certification"

        mapping={
          ("development",test_branch):("DEVELOPMENT","development"),
          (test_branch,"staging"):("TESTING",test_branch),
          ("staging","production"):("STAGING","staging"),
          ("production","main"):("PRODUCTION","production"),
        }
        key=(head,base)
        if key in mapping:
            typ,name=mapping[key]
            cur.execute("""SELECT status,sha FROM scope_certifications
              WHERE product=%s AND scope_type=%s AND scope_name=%s""",
              (product,typ,name))
            row=cur.fetchone()
            return bool(row and row["status"]=="CERTIFIED" and row["sha"]==sha),f"{name} exact-SHA certification"

    return False,f"invalid promotion path {head}->{base}"

def main():
    c=psycopg2.connect(DSN)
    checked=passed=failed=repos_seen=errors=0
    for repo,product,test_branch,repo_path in aliases(c):
        if not os.path.isdir(repo_path):
            continue
        try:
            prs=gh_json(f"repos/{OWNER}/{repo}/pulls?state=open&per_page=100")
            repos_seen+=1
        except Exception as exc:
            print(f"REPO_ERROR repo={repo} error={str(exc)[:120]}")
            errors+=1
            continue
        for pr in prs:
            head=pr["head"]["ref"]; base=pr["base"]["ref"]; sha=pr["head"]["sha"]
            is_bootstrap=head in BOOTSTRAP_HEADS and base in ROOT_BASES
            if not is_bootstrap and not governed(c,product,test_branch,base):
                continue
            ok,reason=validate(c,product,test_branch,repo_path,head,base,sha)
            try:
                post(repo,sha,"success" if ok else "failure",
                     ("CERTIFIED: " if ok else "BLOCKED: ")+reason,
                     pr["html_url"])
            except Exception as exc:
                print(f"STATUS_ERROR repo={repo} pr={pr['number']} error={str(exc)[:120]}")
                errors+=1
                continue
            checked+=1; passed+=int(ok); failed+=int(not ok)
            print(f"STATUS repo={repo} pr={pr['number']} state={'PASS' if ok else 'BLOCK'} reason={reason}")
    print(f"REPOSITORIES={repos_seen} CHECKED={checked} PASS={passed} FAIL={failed} ERRORS={errors}")
    raise SystemExit(1 if errors else 0)

if __name__=="__main__":
    main()
