#!/usr/bin/python3 -I
"""Separately provisioned read-only certifier identity custodian; never certifies."""
from pathlib import Path
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from codestra_control.certifier_observer import run_configured_observer
from codestra_control.publisher_ownership import PublisherUnavailable
try:
    run_configured_observer()
except PublisherUnavailable:
    print('CERTIFIER_OBSERVER_UNAVAILABLE', file=sys.stderr)
    raise SystemExit(78)
