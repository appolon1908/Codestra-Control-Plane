#!/usr/bin/env python3
import json,os,pathlib,re,subprocess
ROOT=pathlib.Path("/srv/codestra")
P3=ROOT/"dev-platform/control-plane/products-v3"
BR="workstation/standalone-v3-20261007"
BEGIN="<!-- CODESTRA-GOVERNANCE-V3:BEGIN -->"
END="<!-- CODESTRA-GOVERNANCE-V3:END -->"

def run(cmd,check=True):
    p=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if check and p.returncode: raise RuntimeError((p.stderr or p.stdout).strip())
    return p

def git(repo,*a,check=True):
    return run(["sudo","-u","codestra","git","-c",f"safe.directory={repo}","-C",str(repo),*a],check)

def gh(*a,check=True):
    return run(["sudo","-u","codestra","env","HOME=/home/codestra","XDG_RUNTIME_DIR=/run/user/1000",
                "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus","gh",*a],check)

def slug(s): return re.sub(r'[^a-z0-9]+','-',s.lower()).strip('-')

for mf in sorted(P3.glob("*.json")):
    spec=json.loads(mf.read_text())
    repo_name=spec["repository"].split("/",1)[1]
    repo=ROOT/"apps"/repo_name
    if not (repo/".git").exists(): continue
    wt=ROOT/"workstations"/repo_name/"governance-v3/repo"
    print(f"=== {repo_name} ===",flush=True)

    git(repo,"fetch","origin","--prune")
    remote=git(repo,"show-ref","--verify","--quiet","refs/remotes/origin/"+BR,check=False).returncode==0
    local=git(repo,"show-ref","--verify","--quiet","refs/heads/"+BR,check=False).returncode==0

    if not local and not remote:
        git(repo,"branch",BR,"origin/development")
    elif not local and remote:
        git(repo,"branch","--track",BR,"origin/"+BR)

    if not (wt/".git").exists():
        wt.parent.mkdir(parents=True,exist_ok=True); os.chown(wt.parent,1000,1000)
        if wt.exists() and any(wt.iterdir()): raise RuntimeError(f"{repo_name}: governance-v3 path nonempty")
        if wt.exists(): wt.rmdir()
        git(repo,"worktree","add",str(wt),BR)

    if git(wt,"status","--porcelain").stdout.strip():
        raise RuntimeError(f"{repo_name}: governance-v3 worktree dirty")

    contract=f"""{BEGIN}
# Codestra Governed Development Contract v3

Standalone family: {spec['family_name']}
Component: {spec['product']}

Mandatory hierarchy:
Product -> Section -> Subsection -> Atomic Task

Only authorized promotion:
subsection -> section -> development -> testing -> staging -> production

Agent rules:
- one active lease per subsection;
- work only in the assigned subsection branch/worktree;
- implementation + tests + evidence + commit + push are required;
- review-only output is not completion;
- no force push and no direct protected-environment writes;
- every promotion requires codestra-control-plane plus repository CI;
- dirty, stale, divergent, dependency-incomplete, or uncertified work fails closed.

Production safety:
- PRODUCTION_GO=NO
- LIVE_CAPABILITIES_ENABLED=NO
- EXTERNAL_EFFECTS=false

Live calls, SMS, email, WhatsApp, payments, publishing, credential issuance,
production database writes, and production infrastructure mutation remain disabled
until separately certified and explicitly approved.
{END}
"""
    agents=wt/"AGENTS.md"
    old=agents.read_text() if agents.exists() else ""
    if BEGIN in old and END in old:
        new=old.split(BEGIN,1)[0]+contract+old.split(END,1)[1]
    elif old.strip():
        new=contract+"\n\n# Existing repository-specific instructions\n\n"+old
    else:
        new=contract
    agents.write_text(new)

    gd=wt/".codestra/governance"; gd.mkdir(parents=True,exist_ok=True)
    policy={
      "schema_version":"codestra.governance.v3","family":spec["family"],"product":spec["product"],
      "repository":spec["repository"],"required_status":"codestra-control-plane",
      "promotion_chain":["subsection","section","development","testing","staging","production"],
      "worktree_mode":"lazy-subsection",
      "production":{"PRODUCTION_GO":"NO","LIVE_CAPABILITIES_ENABLED":"NO","EXTERNAL_EFFECTS":"false"},
      "force_push":False,"direct_protected_branch_writes":False
    }
    (gd/"policy.json").write_text(json.dumps(policy,indent=2)+"\n")
    wm={"schema_version":"codestra.workstations.v3","family":spec["family"],"product":spec["product"],
        "sections":[{"section":s["section"],"branch":s["branch"],"order":s["order"],"depends_on":s["depends_on"],
          "subsections":[{"subsection":x["subsection"],"workstation_id":x["workstation"],"branch":x["branch"],
            "parent_branch":x["parent_branch"],"order":x["order"],"depends_on":x["depends_on"],
            "required_gates":x["required_gates"],"worktree":x["worktree"]} for x in s["subsections"]]}
          for s in spec["sections"]]}
    (gd/"workstations.json").write_text(json.dumps(wm,indent=2)+"\n")
    for p in (agents,gd/"policy.json",gd/"workstations.json"): os.chown(p,1000,1000)
    os.chown(gd,1000,1000)

    git(wt,"add","AGENTS.md",".codestra/governance/policy.json",".codestra/governance/workstations.json")
    git(wt,"diff","--check","--cached")
    if git(wt,"diff","--cached","--quiet",check=False).returncode!=0:
        git(wt,"commit","-m","chore(governance): install standalone development system v3")

    # Push only if remote source branch does not already contain this exact SHA.
    sha=git(wt,"rev-parse","HEAD").stdout.strip()
    remote_sha=git(repo,"ls-remote","--heads","origin","refs/heads/"+BR).stdout.split()
    remote_sha=remote_sha[0] if remote_sha else ""
    if remote_sha != sha:
        if remote_sha:
            raise RuntimeError(f"{repo_name}: remote v3 branch moved; refusing overwrite")
        git(wt,"push","-u","origin",BR)
    else:
        git(wt,"branch","--set-upstream-to","origin/"+BR,BR,check=False)

    # Open or reuse the PR.
    existing=gh("pr","list","--repo",spec["repository"],"--state","open","--head",BR,"--base","development",
                "--json","number,url","--jq",".[0] // empty").stdout.strip()
    if not existing:
        url=gh("pr","create","--repo",spec["repository"],"--head",BR,"--base","development",
               "--title","chore(governance): install standalone development system v3",
               "--body",
               "Installs the standalone Codestra development operating system: product → section → subsection → atomic task; isolated agent workstations; exact-SHA control-plane certification; and governed promotion development → testing → staging → production. Existing repository-specific instructions are preserved. Production effects remain disabled.").stdout.strip()
        print(f"PR_CREATED={url}",flush=True)
    else:
        print(f"PR_EXISTING={existing}",flush=True)
    print(f"SHA={sha}",flush=True)
