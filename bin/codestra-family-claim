#!/usr/bin/env python3
import argparse,json,os,pathlib,subprocess
ROOT=pathlib.Path("/srv/codestra/dev-platform/control-plane")
ap=argparse.ArgumentParser()
ap.add_argument("family"); ap.add_argument("--agent",required=True); ap.add_argument("--task",required=True)
args=ap.parse_args()

p=subprocess.run([str(ROOT/"bin/codestra-family-next"),args.family],text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
if p.returncode or not p.stdout.strip() or p.stdout.startswith("NO_READY"):
    raise SystemExit(p.stdout.strip() or p.stderr.strip() or "NO_READY_WORKSTATION")
row=json.loads(p.stdout)
wid=row["workstation_id"]

subprocess.run([str(ROOT/"bin/codestra-workstation-materialize"),wid,"--section"],check=True)
env=os.environ.copy()
env.setdefault("CODESTRA_CONTROL_DSN","host=127.0.0.1 port=5432 dbname=codestra_dev_control user=codestra")
env["PRODUCTION_GO"]="NO"; env["LIVE_CAPABILITIES_ENABLED"]="NO"; env["EXTERNAL_EFFECTS"]="false"
subprocess.run([str(ROOT/"bin/codestra-devctl"),"claim",wid,"--agent",args.agent,"--task",args.task],env=env,check=True)
subprocess.run([str(ROOT/"bin/codestra-devctl"),"preflight",wid,"--agent",args.agent],env=env,check=True)
print(json.dumps({"family":args.family,"workstation_id":wid,"product":row["product"],"section":row["section"],
                  "subsection":row["subsection"],"branch":row["branch"],"worktree":row["worktree"],
                  "agent":args.agent,"status":"CLAIMED_PREFLIGHT_OK"}))
