#!/usr/bin/env python3
import argparse,json,pathlib,psycopg2,os
from psycopg2.extras import RealDictCursor
ROOT=pathlib.Path("/srv/codestra/dev-platform/control-plane")
DSN=os.environ.get("CODESTRA_CONTROL_DSN","host=127.0.0.1 port=5432 dbname=codestra_dev_control user=codestra")
ap=argparse.ArgumentParser(); ap.add_argument("family"); args=ap.parse_args()
f=json.loads((ROOT/"families"/(args.family+".json")).read_text())
products=[x["product"] for x in f["components"]]
with psycopg2.connect(DSN) as c,c.cursor(cursor_factory=RealDictCursor) as cur:
  cur.execute("""SELECT product,status,count(*) n FROM workstations
                 WHERE product=ANY(%s) GROUP BY product,status ORDER BY product,status""",(products,))
  rows=cur.fetchall()
  cur.execute("""SELECT product,count(*) FILTER (WHERE status='CERTIFIED') certified,
                        count(*) total FROM sections WHERE product=ANY(%s)
                 GROUP BY product ORDER BY product""",(products,))
  secs=cur.fetchall()
print(f"FAMILY={f['name']}")
print("PROMOTION=development -> testing -> staging -> production")
print("PRODUCTION_GO=NO LIVE_CAPABILITIES_ENABLED=NO EXTERNAL_EFFECTS=false")
for s in secs:
  print(f"{s['product']}|SECTIONS={s['total']}|CERTIFIED_SECTIONS={s['certified']}")
for r in rows:
  print(f"{r['product']}|{r['status']}={r['n']}")
